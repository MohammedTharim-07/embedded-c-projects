#pragma config FOSC = INTRC_NOCLKOUT
#pragma config WDTE = OFF
#pragma config PWRTE = ON
#pragma config MCLRE = ON
#pragma config CP = OFF
#pragma config CPD = OFF
#pragma config BOREN = OFF
#pragma config IESO = ON
#pragma config FCMEN = ON
#pragma config LVP = OFF
// CONFIG2
#pragma config BOR4V = BOR40V
#pragma config WRT = OFF
#include <xc.h>


#define MOTOR_FWD RD0  
#define MOTOR_REV RD1   
#define LAMP      RA5   

void delay();
void button();
void lm35();
void wash_cycle(unsigned int run_ms);
void motor_forward();
void motor_reverse();
void motor_stop();

unsigned int total;
volatile unsigned int per;
unsigned char str[]="WASH READY";

void delay(unsigned int ms)
{
    unsigned int i;
    for(int i=0;i<ms;i++)
    {
        TMR1H=0XFF;
        TMR1L=0X06;
         TMR1IF = 0;
      TMR1ON = 1;
        while(!TMR1IF);
     TMR1ON = 0;  
    }
}
void enable()
{
    RE1=1;
    delay(1);
    RE1=0;
    delay(1);
}
void lcd(char cmd,char data)
{
    RE0=cmd;
    PORTC=data;
    enable();
}
void lcd_data()
{
            lcd(1,(total/1000)+'0');
            lcd(1,(total/100)%10+'0');
            lcd(1,(total/10)%10+'0');
            lcd(1,(total%10)+'0');  
}
void lcd_string(char *str)
{
 while(*str!='\0')
 {
     lcd(1,*str);
     str++;
 }
}
void lm35()
{
    delay(2);
    GO=1;
    while(GO);
    
    total=ADRESL+ADRESH*256;
    
    ADCON0=0X81;        
    delay(100);
    
    per=total*0.146484375;
 //  per=total*0.4887585532746823;
    lcd(0,0x01);
    if(per>19 && per<21)
    {
        lcd(0,0x80);
        lcd_string("LOW ");
        lcd(1,(per/10)%10+'0');
        lcd(1,(per%10)+'0');
    }
    else if(per>=35 && per<=37)
    {
        lcd(0,0x80);
        lcd_string("MEDIUM ");
        lcd(1,(per/10)%10+'0');
        lcd(1,(per%10)+'0');
    }
    else if(per>=44 && per<=46)
    {
        lcd(0,0x80);
        lcd_string("HIGH ");
        lcd(1,(per/10)%10+'0');
        lcd(1,(per%10)+'0');
    }
}

void motor_forward()
{
    MOTOR_REV=1;
    MOTOR_FWD=0;
}
void motor_reverse()
{
    MOTOR_FWD=1;
    MOTOR_REV=0;
}
void motor_stop()
{
    MOTOR_FWD=0;
    MOTOR_REV=0;
}


void wash_cycle(unsigned int run_ms)
{
    motor_forward();
    delay(run_ms);
    motor_stop();
    delay(500);

    motor_reverse();
    delay(run_ms);
    motor_stop();
    delay(500);

    LAMP=1;
    lcd(0,0x01);
    lcd(0,0x80);
    lcd_string("WASH COMPLETE");
    delay(3000);
    LAMP=0;
}

void button()
{
    if(RA1 == 1)
    {
        lcd(0,0x01);
        lcd(0,0x80);
        lcd_string(str);
        delay(2000);      
        lcd(0,0x01);

        unsigned char done=0;
        while(!done)
        {
            lm35();

            if(per>19 && per<21)
            {
                wash_cycle(5000);
                done=1;
            }
            else if(per>=35 && per<=37)
            {
                wash_cycle(10000);
                done=1;
            }
            else if(per>=44 && per<=46)
            {
                wash_cycle(20000);
                done=1;
            }
        }

        while(RA1);
    }
}
void main()
{
    PORTA=PORTC=PORTD=PORTE=0X00;
    TRISA=0X0B;
    TRISC=TRISD=TRISE=0X00;
    ANSEL=0X09;          
    ANSELH=0X00;
    ADCON0=0X81;        
    ADCON1=0X90;
    T1CON=0X21;
     
    delay(20);
     lcd(0,0x38);
    lcd(0,0x0C);
    lcd(0,0x01);
    lcd(0,0x06);
    while(1)
    {
        button();      
    }
}
